
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hotelapp.Controlador"
      spacing="12"
      alignment="TOP_CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="HotelApp - Sistema de reservas"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Listado de habitaciones"/>

    <TextArea fx:id="areaHabitaciones"
              editable="false"
              prefHeight="180"
              wrapText="true"/>

    <Label text="Buscar habitación por número"/>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="campoNumero"
                   promptText="Ejemplo: 101"
                   onAction="#buscarHabitacion"/>
        <Button text="Buscar"
                onAction="#buscarHabitacion"/>
    </HBox>

    <Label fx:id="etiquetaResultado"
           text="Introduce un número de habitación."
           wrapText="true"
           style="-fx-font-size: 14px;"/>

</VBox>
